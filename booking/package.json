{
  "name": "alamo-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Booking engine for Alamo City Rental: Airbnb and VRBO calendar sync, pricing, checkout",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check-calendar": "tsx src/cli.ts",
    "export-link": "tsx src/exportLink.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1151.0",
    "@aws-sdk/client-sns": "3.1151.0",
    "@aws-sdk/client-ssm": "3.1151.0",
    "@aws-sdk/lib-dynamodb": "3.1151.0",
    "ical-generator": "11.1.2",
    "node-ical": "0.27.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
